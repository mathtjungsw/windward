{
  "rules": {
    ".read": false,
    ".write": false,
    "fleet": {
      "v1": {
        ".read": "auth != null && query.orderByChild == 'updatedAt' && query.limitToLast != null && query.limitToLast <= 100",
        ".indexOn": [
          "updatedAt"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['name','lon','lat','angle','color','status','updatedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
          },
          "lon": {
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          },
          "lat": {
            ".validate": "newData.isNumber() && newData.val() >= -80 && newData.val() <= 80"
          },
          "angle": {
            ".validate": "newData.isNumber() && newData.val() >= -360 && newData.val() <= 360"
          },
          "color": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 6 && newData.val() % 1 == 0"
          },
          "status": {
            ".validate": "newData.val() == '정박' || newData.val() == '항해' || newData.val() == '멈춤'"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          },
          "money": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000 && newData.val() % 1 == 0"
          },
          "profit": {
            ".validate": "newData.isNumber() && newData.val() >= -1000000000000 && newData.val() <= 1000000000000 && newData.val() % 1 == 0"
          },
          "visited": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 64 && newData.val() % 1 == 0"
          }
        }
      }
    },
    "chat": {
      "v1": {
        ".validate": "newData.hasChildren(['sequence','messages','lastSent']) && newData.child('sequence').val() == (data.child('sequence').exists() ? data.child('sequence').val() : 0) + 1 && newData.child('lastSent').child(auth.uid).val() == now && (!data.child('lastSent').child(auth.uid).exists() || now - data.child('lastSent').child(auth.uid).val() >= 3000) && newData.child('messages').child('' + (newData.child('sequence').val() % 50)).child('seq').val() == newData.child('sequence').val() && newData.child('messages').child('' + (newData.child('sequence').val() % 50)).child('uid').val() == auth.uid && newData.child('messages').child('' + (newData.child('sequence').val() % 50)).child('at').val() == now",
        "sequence": {
          ".read": "auth != null",
          ".write": "auth != null && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9007199254740991 && newData.val() % 1 == 0"
        },
        "messages": {
          ".read": "auth != null && query.orderByChild == 'seq' && query.limitToLast != null && query.limitToLast <= 50",
          ".indexOn": [
            "seq"
          ],
          "$slot": {
            ".write": "auth != null && newData.exists() && $slot == '' + (newData.child('seq').val() % 50)",
            ".validate": "newData.hasChildren(['seq','uid','name','text','at']) && newData.child('seq').val() == newData.parent().parent().child('sequence').val() && newData.child('uid').val() == auth.uid && newData.child('at').val() == now",
            "seq": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 == 0"
            },
            "uid": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() == now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "lastSent": {
          ".read": "auth != null && query.orderByValue == true && query.limitToFirst != null && query.limitToFirst <= 20 && query.endAt != null && query.endAt <= now - 86400000",
          ".indexOn": [
            ".value"
          ],
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && ((auth.uid == $uid && newData.isNumber() && newData.val() == now) || (!newData.exists() && data.isNumber() && data.val() < now - 86400000))"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
