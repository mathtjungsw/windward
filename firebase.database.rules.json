{
  "rules": {
    ".read": false,
    ".write": false,
    "gameV2": {
      "accounts": {
        "$uid": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid",
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid && newData.exists()",
          ".validate": "newData.hasChildren(['name','updatedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
          },
          "seenVersion": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "updatedAt": {
            ".validate": "newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "privateSaves": {
        "$uid": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid",
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid && newData.exists() && (newData.child('schemaVersion').val() == 2 || newData.child('schemaVersion').val() == 3) && (!data.exists() || data.child('schemaVersion').val() != 3 || newData.child('schemaVersion').val() == 3)",
          ".validate": "newData.hasChildren(['revision','data','session','leaseUntil','updatedAt']) && newData.child('revision').val() == (data.child('revision').exists() ? data.child('revision').val() : 0) + 1",
          "revision": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 == 0"
          },
          "session": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "leaseUntil": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 120000"
          },
          "updatedAt": {
            ".validate": "newData.val() == now"
          },
          "data": {
            ".validate": "newData.isString() && newData.val().length > 20 && newData.val().length <= 200000"
          },
          "$other": {
            ".validate": false
          },
          "schemaVersion": {
            ".validate": "newData.val() == 2 || newData.val() == 3"
          }
        }
      },
      "real": {
        "rankings": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && (((query.orderByChild == 'money' || query.orderByChild == 'profit' || query.orderByChild == 'visited' || query.orderByChild == 'explorationScore' || query.orderByChild == 'fame') && query.limitToLast != null && (query.limitToLast <= 5 || (query.limitToLast <= 1000 && query.startAt != null))) || (query.orderByKey == true && query.limitToFirst != null && query.limitToFirst <= 20))",
          ".indexOn": [
            "money",
            "profit",
            "visited",
            "explorationScore",
            "fame"
          ],
          "$uid": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid && newData.exists()",
            ".validate": "newData.hasChildren(['name','money','profit','visited','updatedAt']) && (!data.child('statsVersion').exists() || data.child('statsVersion').val() != 3 || newData.child('statsVersion').val() == 3) && (!newData.child('statsVersion').exists() || (newData.hasChildren(['explorationScore','explorationArea','explorationPercent','foundCount','fame','shipTier','fleetCount','saveRevision']) && (!data.child('saveRevision').exists() || newData.child('saveRevision').val() >= data.child('saveRevision').val())))",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
            },
            "money": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000 && newData.val() % 1 == 0"
            },
            "profit": {
              ".validate": "newData.isNumber() && newData.val() >= -1000000000000 && newData.val() <= 1000000000000 && newData.val() % 1 == 0"
            },
            "visited": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 104 && newData.val() % 1 == 0"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() == now"
            },
            "$other": {
              ".validate": false
            },
            ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com'",
            "explorationScore": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 == 0"
            },
            "explorationArea": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && newData.val() % 1 == 0"
            },
            "explorationPercent": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "foundCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 32 && newData.val() % 1 == 0"
            },
            "fame": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 12800 && newData.val() % 1 == 0"
            },
            "shipTier": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 19 && newData.val() % 1 == 0"
            },
            "fleetCount": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 == 0"
            },
            "statsVersion": {
              ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 3 && newData.val() % 1 == 0"
            },
            "saveRevision": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9007199254740991 && newData.val() % 1 == 0"
            }
          }
        },
        "chat": {
          ".validate": "newData.hasChildren(['sequence','messages','lastSent']) && newData.child('sequence').val() == (data.child('sequence').exists() ? data.child('sequence').val() : 0) + 1 && newData.child('lastSent').child(auth.uid).val() == now && (!data.child('lastSent').child(auth.uid).exists() || now - data.child('lastSent').child(auth.uid).val() >= 3000) && newData.child('messages').child('' + (newData.child('sequence').val() % 50)).child('seq').val() == newData.child('sequence').val() && newData.child('messages').child('' + (newData.child('sequence').val() % 50)).child('uid').val() == auth.uid && newData.child('messages').child('' + (newData.child('sequence').val() % 50)).child('at').val() == now",
          "sequence": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com'",
            ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && newData.exists()",
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9007199254740991 && newData.val() % 1 == 0"
          },
          "messages": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && query.orderByChild == 'seq' && query.limitToLast != null && query.limitToLast <= 50",
            ".indexOn": [
              "seq"
            ],
            "$slot": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && newData.exists() && $slot == '' + (newData.child('seq').val() % 50)",
              ".validate": "newData.hasChildren(['seq','uid','name','text','at']) && newData.child('seq').val() == newData.parent().parent().child('sequence').val() && newData.child('uid').val() == auth.uid && newData.child('at').val() == now && ((!newData.child('kind').exists() && !newData.child('ref').exists()) || (newData.child('kind').exists() && newData.child('ref').exists()))",
              "seq": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 == 0"
              },
              "uid": {
                ".validate": "newData.isString() && newData.val() == auth.uid"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
              },
              "text": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() == now"
              },
              "$other": {
                ".validate": false
              },
              "kind": {
                ".validate": "newData.val() == 'port' || newData.val() == 'route' || newData.val() == 'signal'"
              },
              "ref": {
                ".validate": "(newData.parent().child('kind').val() == 'port' && newData.hasChild('portId')) || (newData.parent().child('kind').val() == 'route' && newData.hasChildren(['fromPortId','toPortId','observedNm']) && newData.child('fromPortId').val() != newData.child('toPortId').val()) || (newData.parent().child('kind').val() == 'signal' && newData.hasChildren(['code','targetUid','targetName']))",
                "portId": {
                  ".validate": "newData.parent().parent().child('kind').val() == 'port' && newData.isString() && newData.val().matches(/^(lisbon|seville|london|amsterdam|venice|alexandria|accra|cape|zanzibar|muscat|goa|malacca|batavia|macau|nagasaki|busan|havana|cartagena|recife|buenos|sydney|porto|bordeaux|marseille|barcelona|genoa|naples|athens|istanbul|rotterdam|cologne|ruse|belgrade|sanlucar|dublin|tangier|tunis|dakar|luanda|maputo|mombasa|cairo|luxor|mogadishu|aden|jeddah|kochi|colombo|chennai|singapore|manila|shanghai|nanjing|wuhan|neworleans|memphis|macapa|santarem|manaus|rio|salvador|callao|perth|auckland|setubal|sines|lagos|faro|cadiz|vigo|acoruna|bilbao|plymouth|southampton|larochelle|funchal|laspalmas|angra|ribeiragrande|safi|algiers|dubrovnik|hormuz|calicut|mocha|ternate|bandaneira|quanzhou|portlouis|toamasina|boston|halifax|veracruz|acapulco|sanfrancisco|valparaiso|ushuaia|honolulu|suva|papeete|hangaroa|portmoresby|hobart|apia)$/)"
                },
                "fromPortId": {
                  ".validate": "newData.parent().parent().child('kind').val() == 'route' && newData.isString() && newData.val().matches(/^(lisbon|seville|london|amsterdam|venice|alexandria|accra|cape|zanzibar|muscat|goa|malacca|batavia|macau|nagasaki|busan|havana|cartagena|recife|buenos|sydney|porto|bordeaux|marseille|barcelona|genoa|naples|athens|istanbul|rotterdam|cologne|ruse|belgrade|sanlucar|dublin|tangier|tunis|dakar|luanda|maputo|mombasa|cairo|luxor|mogadishu|aden|jeddah|kochi|colombo|chennai|singapore|manila|shanghai|nanjing|wuhan|neworleans|memphis|macapa|santarem|manaus|rio|salvador|callao|perth|auckland|setubal|sines|lagos|faro|cadiz|vigo|acoruna|bilbao|plymouth|southampton|larochelle|funchal|laspalmas|angra|ribeiragrande|safi|algiers|dubrovnik|hormuz|calicut|mocha|ternate|bandaneira|quanzhou|portlouis|toamasina|boston|halifax|veracruz|acapulco|sanfrancisco|valparaiso|ushuaia|honolulu|suva|papeete|hangaroa|portmoresby|hobart|apia)$/)"
                },
                "toPortId": {
                  ".validate": "newData.parent().parent().child('kind').val() == 'route' && newData.isString() && newData.val().matches(/^(lisbon|seville|london|amsterdam|venice|alexandria|accra|cape|zanzibar|muscat|goa|malacca|batavia|macau|nagasaki|busan|havana|cartagena|recife|buenos|sydney|porto|bordeaux|marseille|barcelona|genoa|naples|athens|istanbul|rotterdam|cologne|ruse|belgrade|sanlucar|dublin|tangier|tunis|dakar|luanda|maputo|mombasa|cairo|luxor|mogadishu|aden|jeddah|kochi|colombo|chennai|singapore|manila|shanghai|nanjing|wuhan|neworleans|memphis|macapa|santarem|manaus|rio|salvador|callao|perth|auckland|setubal|sines|lagos|faro|cadiz|vigo|acoruna|bilbao|plymouth|southampton|larochelle|funchal|laspalmas|angra|ribeiragrande|safi|algiers|dubrovnik|hormuz|calicut|mocha|ternate|bandaneira|quanzhou|portlouis|toamasina|boston|halifax|veracruz|acapulco|sanfrancisco|valparaiso|ushuaia|honolulu|suva|papeete|hangaroa|portmoresby|hobart|apia)$/)"
                },
                "observedNm": {
                  ".validate": "newData.parent().parent().child('kind').val() == 'route' && newData.isNumber() && newData.val() > 0 && newData.val() <= 100000"
                },
                "code": {
                  ".validate": "newData.parent().parent().child('kind').val() == 'signal' && (newData.val() == 'hello' || newData.val() == 'thanks' || newData.val() == 'fairwind')"
                },
                "targetUid": {
                  ".validate": "newData.parent().parent().child('kind').val() == 'signal' && newData.isString() && newData.val().length > 0 && newData.val().length <= 128 && newData.val() != auth.uid"
                },
                "targetName": {
                  ".validate": "newData.parent().parent().child('kind').val() == 'signal' && newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "lastSent": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && query.orderByValue == true && query.limitToFirst != null && query.limitToFirst <= 20 && query.endAt != null && query.endAt <= now - 86400000",
            ".indexOn": [
              ".value"
            ],
            "$uid": {
              ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid",
              ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && ((auth.uid == $uid && newData.isNumber() && newData.val() == now) || (!newData.exists() && data.isNumber() && data.val() < now - 86400000))"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "sectors": {
          "$sector": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && query.orderByChild == 'updatedAt' && query.limitToLast != null && query.limitToLast <= 100",
            ".indexOn": [
              "updatedAt"
            ],
            "$boat": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && $boat.beginsWith(auth.uid + '_') && (!data.exists() || data.child('uid').val() == auth.uid) && (!newData.exists() || newData.child('uid').val() == auth.uid)",
              ".validate": "newData.hasChildren(['uid','name','lon','lat','angle','color','status','updatedAt'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
              },
              "lon": {
                ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
              },
              "lat": {
                ".validate": "newData.isNumber() && newData.val() >= -80 && newData.val() <= 80"
              },
              "angle": {
                ".validate": "newData.isNumber() && newData.val() >= -360 && newData.val() <= 360"
              },
              "color": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 6 && newData.val() % 1 == 0"
              },
              "status": {
                ".validate": "newData.val() == '정박' || newData.val() == '항해' || newData.val() == '멈춤'"
              },
              "updatedAt": {
                ".validate": "newData.isNumber() && newData.val() == now"
              },
              "$other": {
                ".validate": false
              },
              "money": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000 && newData.val() % 1 == 0"
              },
              "profit": {
                ".validate": "newData.isNumber() && newData.val() >= -1000000000000 && newData.val() <= 1000000000000 && newData.val() % 1 == 0"
              },
              "visited": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 88 && newData.val() % 1 == 0"
              },
              "uid": {
                ".validate": "newData.isString() && newData.val() == auth.uid"
              },
              "shipTier": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 19 && newData.val() % 1 == 0"
              },
              "fleetCount": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 == 0"
              }
            }
          }
        },
        "captains": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && query.orderByChild == 'updatedAt' && query.limitToLast != null && query.limitToLast <= 100",
          ".indexOn": [
            "updatedAt"
          ],
          "$session": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && $session.beginsWith(auth.uid + '_') && (!data.exists() || data.child('uid').val() == auth.uid) && (!newData.exists() || newData.child('uid').val() == auth.uid)",
            ".validate": "newData.hasChildren(['uid','name','color','status','updatedAt'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() == auth.uid && newData.val().length <= 128"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
            },
            "color": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 6 && newData.val() % 1 == 0"
            },
            "status": {
              ".validate": "newData.val() == '정박' || newData.val() == '항해' || newData.val() == '멈춤'"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() == now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
