{
  "rules": {
    ".read": false,
    ".write": false,
    "fleet": {
      "v1": {
        ".read": "auth != null && query.orderByChild == 'updatedAt' && query.limitToLast <= 30",
        ".indexOn": ["updatedAt"],
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['name','lon','lat','angle','color','status','updatedAt'])",
          "name": {".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"},
          "lon": {".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"},
          "lat": {".validate": "newData.isNumber() && newData.val() >= -80 && newData.val() <= 80"},
          "angle": {".validate": "newData.isNumber() && newData.val() >= -360 && newData.val() <= 360"},
          "color": {".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 6 && newData.val() % 1 == 0"},
          "status": {".validate": "newData.val() == '정박' || newData.val() == '항해' || newData.val() == '멈춤'"},
          "updatedAt": {".validate": "newData.isNumber() && newData.val() == now"},
          "$other": {".validate": false}
        }
      }
    }
  }
}
